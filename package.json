{
  "name": "vibe-course",
  "version": "1.0.0",
  "description": "Zero-config CLI that turns local repositories into structured, interactive developer courses",
  "type": "module",
  "bin": {
    "vibe-course": "./dist/bin/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/index.ts",
    "start": "node dist/bin/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "course",
    "learning",
    "developer",
    "llm",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "commander": "^12.1.0",
    "globby": "^14.0.2",
    "ignore": "^6.0.2",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "undici": "^8.10.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
